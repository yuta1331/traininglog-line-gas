{
  "name": "line-training-log",
  "version": "1.0.0",
  "description": "A bot that saves workout records to a spreadsheet via LINE",
  "scripts": {
    "build": "webpack && npm run copy:manifest",
    "copy:manifest": "node -e \"require('fs').copyFileSync('src/appsscript.json','dist/appsscript.json')\"",
    "deploy": "npm run build && clasp push",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json"
  },
  "devDependencies": {
    "@types/google-apps-script": "^2.0.7",
    "@types/node": "^22.15.2",
    "gas-webpack-plugin": "^2.6.0",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "typescript": "5.9.3",
    "vitest": "^4.1.10",
    "webpack": "^5.99.7",
    "webpack-cli": "^6.0.1"
  }
}
